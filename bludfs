import flask, jsonify, requests, make_response
import jwt
import datetime
from functools import wraps

app = flask(__name__)

app.config['SECRET_KEY'] = 'minha chave secreta'

def token_requerido(f):
    @wraps(f)
    def decorator(*args, **kwargs):
        token = requests.headers.get('x-access-token')
        if not token:
            return jsonify({'mensagem': 'token de acesso é necessario Boca aberta!'})
        try:
            dados = jwt.decode(token, app.config['SECRET_KEY'], algorithms=["HS256"])
            requests.user_data = dados
        except:
            return jsonify({'mensagem': 'Token invalido, anta!'}), 401
        return f(*args, **kwargs)
    return decorator

